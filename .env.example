# myharness environment file - copy to `.env` (or export in your shell).
# The harness loads the nearest .env automatically; real environment
# variables always win. NEVER commit your real .env.

# Z.ai API key (recommended for GLM):
ZAI_API_KEY=

# Optional overrides:
# GLM_API_KEY=
# MYHARNESS_API_KEY=
# ANTHROPIC_BASE_URL=
# OPENAI_BASE_URL=
# MYHARNESS_DATA_DIR=
